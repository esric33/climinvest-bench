  "output_rules": {
    "block_order": "Emit exactly required_blocks in listed order, with no extra headings, prose blocks, or tables.",
    "number_format": "Use comma thousands separators for integers and two decimal places for floats. Use the same unit label, placement, and spacing as retrieved factoids with that unit; do not substitute symbols or aliases. Do not display a unit for dimensionless comparison or score values. Append x directly for ratio units.",
    "prose": "Each required prose block is one Markdown paragraph. Prose may synthesize evidence, but citations wrap the supported visible claim rather than a generic label.",
    "table_citations": "Wrap the complete displayed table-cell value as [exact value](node_id).",
    "table_text_normalization": "Replace source newlines with spaces, escape literal | as \\|, and encode literal [ and ] inside a displayed value as &#91; and &#93;.",
    "table_values": "Use exact evidence or calculated values in table cells; do not paraphrase, rename, summarize, translate, or correct them."
  },
  "report_title": "Project Investment and Performance Profile",
  "schema_version": "react_report.data_catalogue/v2",
  "sections": [
    {
      "heading": "Project overview",
      "id": "project_overview",
      "required_blocks": [
        {
          "content_contract": {
            "finance_and_scale": "State total project cost, GCF financing, cofinance, the implementation period, expected lifespan and canonical GHG reduction.",
            "format": "Use one Markdown paragraph.",
            "identity": "Identify the project by code and title, then state its type, sector, size, countries and accredited entity.",
            "intervention": "Briefly describe the intervention and intended climate outcome using the project description.",
            "scope": "Use only project front matter; do not discuss calculated indicators, selected KPIs or risks."
          },
          "id": "project_overview.prose",
          "kind": "prose"
